# Firebase Configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase Service Account (for backend operations)
VITE_FIREBASE_SERVICE_ACCOUNT_TYPE=service_account
VITE_FIREBASE_SERVICE_ACCOUNT_PROJECT_ID=
VITE_FIREBASE_SERVICE_ACCOUNT_PRIVATE_KEY_ID=
VITE_FIREBASE_SERVICE_ACCOUNT_PRIVATE_KEY=
VITE_FIREBASE_SERVICE_ACCOUNT_CLIENT_EMAIL=
VITE_FIREBASE_SERVICE_ACCOUNT_CLIENT_ID=
VITE_FIREBASE_SERVICE_ACCOUNT_AUTH_URI=
VITE_FIREBASE_SERVICE_ACCOUNT_TOKEN_URI=

# DeepL Translation API Configuration
# Get your API key from: https://www.deepl.com/pro/change-subscription
# Free API key format: xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx:fx
# Pro API key format: xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
VITE_DEEPL_API_KEY=f8e32d88-0be0-491a-aec2-297eaa7b8b41:fx

# Firebase Cloud Functions URLs for translation (proxies DeepL to avoid CORS issues)
VITE_FIREBASE_FUNCTIONS_URL=https://us-central1-ogs-solutions.cloudfunctions.net/translateText
VITE_FIREBASE_BATCH_URL=https://us-central1-ogs-solutions.cloudfunctions.net/translateBatch
# GitHub Storage Configuration (REQUIRED for file uploads in messages)
# Create a GitHub Personal Access Token:
# 1. Go to GitHub Settings → Developer settings → Personal access tokens → Tokens (classic)
# 2. Click "Generate new token (classic)"
# 3. Select "repo" scope (full control of private repositories)
# 4. Copy the token below
# 5. Create a private repository for file storage (e.g., "ogs-solutions-files")

VITE_GITHUB_OWNER=your-github-username
VITE_GITHUB_REPO=ogs-solutions-files
VITE_GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_GITHUB_BRANCH=main